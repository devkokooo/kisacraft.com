---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import imgJuice from "../assets/juice.png";
import imgCake from "../assets/cake.png";

const kisacraftAddr = "mc.kisacraft.com";
import imgKitsune from "../assets/kitsune3.png";
import imgBell from "../assets/bell1.png";
---

<Layout>
  <main class="w-screen h-screen grid place-items-center">
    <div>
      <!-- Title wrapper -->
      <div class="flex gap-6 justify-center items-center">
        <!-- Title, pink gradient text with white accent border -->
        <div class="relative grid place-items-center">
          <!-- Background "accent" border -->
          <h1 class="
            title-outline font-custom-main font-black text-8xl tracking-tight
            drop-shadow-sm drop-shadow-red-900
          ">
            Kisacraft
          </h1>

          <!-- Main title gradient text -->
          <h1 class="
            fixed text-transparent bg-clip-text
            bg-linear-to-t from-red-800 via-rose-600 to-rose-400
            z-10 font-custom-main font-black text-8xl tracking-tight
          ">
            Kisacraft
          </h1>
        </div>
      </div>

      <!-- Subtitle, cute japanese katakana text -->
      <div class="mt-6 flex gap-6 justify-center items-center">
        <!-- Cute image wrapper -->
        <div class="
          -m-0.5 p-2.5 rounded-full bg-pink-100
          drop-shadow-xs drop-shadow-red-900
        ">
          <Image src={imgJuice} alt="juice" width="32" height="32" class="-rotate-20" />
        </div>

        <!-- Heart -->
        <span class="text-pink-100 text-3xl drop-shadow-xs drop-shadow-red-900">♥</span>

        <!-- Subtitle wrapper -->
        <div class="relative grid place-items-center">
          <!-- Background "accent" border -->
          <h2 class="
            subtitle-outline font-custom-main font-black text-3xl tracking-tighter
            drop-shadow-sm drop-shadow-red-900
          ">
            キサクラフト
          </h2>

          <!-- Subtitle gradient text -->
          <h2 class="
            fixed text-transparent bg-clip-text
            bg-linear-to-t from-red-800 via-rose-600 to-rose-400
            z-10 font-custom-main font-black text-3xl tracking-tighter
          ">
            キサクラフト
          </h2>
        </div>

        <!-- Heart -->
        <span class="text-pink-100 text-3xl drop-shadow-xs drop-shadow-red-900">♥</span>

        <!-- Cute image wrapper -->
        <div class="
          -m-0.5 p-2.5 rounded-full bg-pink-100
          drop-shadow-xs drop-shadow-red-900
        ">
          <Image src={imgCake} alt="cake" width="32" height="32" class="rotate-10" />
        </div>
      </div>

      <!-- Server IP address, and other socials (twitch, discord) -->
      <div class="mt-12 flex justify-center items-center">
        <!-- Server IP link -->
        <div class="
          flex gap-4 items-center
          bg-pink-100 px-4 py-4 rounded-xl
          outline-2 outline-rose-400
        ">
          <Image src={imgKitsune} alt="kitsune" width="72" height="72" />
          <div class="grid place-items-center">
            <h3 class="text-2xl font-custom-main font-black text-rose-600"> 
              {kisacraftAddr}
            </h3>
            <p class="text-base font-custom-main font-semibold text-rose-400">
              sub-only server
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .font-custom-main {
    font-family: "Zen Maru Gothic", sans-serif;
    font-style: normal;
  }

  .font-custom-second {
    font-family: "M PLUS Rounded 1c", sans-serif;
    font-style: normal;
  }

  .title-outline {
    /* Value looks weird but this is to prevent glyph holes showing for dots  */
    -webkit-text-stroke-width: 29.3px;
    -webkit-text-stroke-color: var(--color-pink-100);
  }

  .subtitle-outline {
    -webkit-text-stroke-width: 16px;
    -webkit-text-stroke-color: var(--color-pink-100);
  }
</style>
