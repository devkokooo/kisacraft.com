---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const kisacraftAddr = "mc.kisacraft.com";
const kisacraftMapAddr = "map.kisacraft.com";

const kisaTwitchHref = "https://twitch.tv/tinykisa";
const kisacordHref = "https://discord.gg/kisa";

import imgJuice from "../assets/juice.png";
import imgCake from "../assets/cake.png";
import imgKitsune from "../assets/kitsune3.png";
import imgBell from "../assets/bell1.png";
import imgKisaBleh from "../assets/kisa-bleh.png";
import imgKisaBow from "../assets/kisa-bow.png";
import imgKisaSilly from "../assets/kisa-silly.png";

import TwitchLogo from "../assets/twitch-logo.svg";
import DiscordLogo from "../assets/discord-logo.svg";
import ArrowUpRight from "../assets/arrow-up-right.svg";
---

<Layout>
  <main class="w-screen h-screen grid place-items-center bg-linear-to-b from-pink-300 to-rose-300">
    <div>
      <!-- Title wrapper -->
      <div class="mt-6 flex gap-6 justify-center items-center md:mt-0">
        <!-- Title, pink gradient text with white accent border -->
        <div class="relative grid place-items-center">
          <!-- Background "accent" border -->
          <h1 class="
            title-outline font-custom-main font-black text-8xl tracking-tight
            drop-shadow-sm drop-shadow-red-900
          ">
            Kisacraft
          </h1>

          <!-- Main title gradient text -->
          <h1 class="
            absolute text-transparent bg-clip-text
            bg-linear-to-t from-red-800 via-rose-600 to-rose-400
            z-10 font-custom-main font-black text-8xl tracking-tight
          ">
            Kisacraft
          </h1>
        </div>
      </div>

      <!-- Subtitle, cute japanese katakana text -->
      <div class="mt-6 flex gap-4 justify-center items-center md:gap-6">
        <!-- Cute image wrapper -->
        <div class="
          -m-0.5 p-2.5 rounded-full bg-pink-100
          drop-shadow-xs drop-shadow-red-900
        ">
          <Image src={imgJuice} alt="juice" width="112" height="112" class="-rotate-20 w-8 h-8" />
        </div>

        <!-- Heart -->
        <span class="text-pink-100 text-3xl drop-shadow-xs drop-shadow-red-900">♥</span>

        <!-- Subtitle wrapper -->
        <div class="relative grid place-items-center">
          <!-- Background "accent" border -->
          <h2 class="
            subtitle-outline font-custom-main font-black text-3xl tracking-tighter
            drop-shadow-sm drop-shadow-red-900
          ">
            キサクラフト
          </h2>

          <!-- Subtitle gradient text -->
          <h2 class="
            absolute text-transparent bg-clip-text
            bg-linear-to-t from-red-800 via-rose-600 to-rose-400
            z-10 font-custom-main font-black text-3xl tracking-tighter
          ">
            キサクラフト
          </h2>
        </div>

        <!-- Heart -->
        <span class="text-pink-100 text-3xl drop-shadow-xs drop-shadow-red-900">♥</span>

        <!-- Cute image wrapper -->
        <div class="
          -m-0.5 p-2.5 rounded-full bg-pink-100
          drop-shadow-xs drop-shadow-red-900
        ">
          <Image src={imgCake} alt="cake" width="112" height="112" class="rotate-10 w-8 h-8" />
        </div>
      </div>

      <!-- Server IP address, server map, and other socials (twitch, discord) -->
      <div class="mt-12 flex flex-col gap-6 items-stretch md:flex-row">
        <!-- Server IP link -->
        <div class="relative flex items-stretch self-center">
          <div class="
            flex gap-4 items-center w-fit self-center
            bg-pink-100 px-4 py-4 rounded-xl rounded-tl-none
            outline-4 outline-rose-400
          ">
            <Image src={imgKitsune} alt="kitsune" width="112" height="112" class="w-20 h-20" />
            <div class="grid place-items-center">
              <h3 class="text-2xl font-custom-main font-black text-rose-600 select-text">
                {kisacraftAddr}
              </h3>
              <p class="text-base font-custom-main font-semibold text-rose-400">
                sub-only server
              </p>
            </div>
          </div>

          <!-- Status badge -->
          <div class="
            absolute -top-5 -left-1 flex items-center px-2 py-1 rounded-md
            bg-linear-to-t from-red-800 via-rose-600 to-rose-400
          ">
            <span class="font-custom font-bold text-sm text-pink-100">
              LAUNCHED!
            </span>
          </div>
        </div>

        <!-- Server map -->
        <a href=`https://${kisacraftMapAddr}` target="_blank" class="group flex items-stretch self-center">
          <div class="relative">
            <div class="
              flex gap-4 items-center h-full group-hover:bg-green-100
              bg-pink-100 px-4 py-4 rounded-xl
              outline-4 outline-rose-400
            ">
              <Image src={imgKisaSilly} alt="kisa-silly" width="320" height="320" class="w-20 h-20" />
              <div class="grid place-items-center">
                <h3 class="text-2xl font-custom-main font-black text-rose-600"> 
                  {kisacraftMapAddr}
                </h3>
                <p class="text-base font-custom-main font-semibold text-rose-400">
                  live 3D map in browser
                </p>
              </div>
            </div>

            <!-- External link indicator -->
            <div class="
              absolute -top-4 -right-4 flex items-center p-3 
              bg-rose-400 rounded-full
            ">
              <ArrowUpRight width="24" height="24" class="text-white stroke-3" />
            </div>
          </div>
        </a>
      </div>

      <div class="mt-6 flex flex-col gap-6 justify-center items-stretch md:flex-row mb-6 md:mb-0">
        <!-- Twitch Channel -->
        <a href={kisaTwitchHref} target="_blank" class="group flex items-stretch self-center">
          <div class="relative">
            <div class="
              flex gap-4 items-center h-full group-hover:bg-green-100
              bg-pink-100 px-4 py-4 rounded-xl
              outline-4 outline-rose-400
            ">
              <Image
                src={imgKisaBleh} alt="kisa-bleh" width="340" height="340"
                class="rounded-md w-20 h-20"
              />
              <div class="grid place-items-center">
                <h3 class="text-2xl font-custom-main font-black text-rose-600"> 
                  tinykisa
                </h3>
                <p class="text-base font-custom-main font-semibold text-rose-400">
                  follow and subscribe!
                </p>
              </div>
            </div>

            <!-- Twitch logo -->
            <div class="
              absolute -top-4 -right-4 flex items-center p-3 
              bg-rose-400 rounded-full
            ">
              <TwitchLogo width="24" height="24" />
            </div>
          </div>
        </a>

        <!-- Discord server -->
        <a href={kisacordHref} target="_blank" class="group flex items-stretch self-center">
          <div class="relative">
            <div class="
             flex gap-4 items-center h-full group-hover:bg-green-100
             bg-pink-100 px-4 py-4 rounded-xl
             outline-4 outline-rose-400
            ">
             <Image src={imgKisaBow} alt="kisa-bow" width="300" height="300" class="w-20 h-20" />
             <div class="grid place-items-center">
               <h3 class="text-2xl font-custom-main font-black text-rose-600"> 
                 kisacord
               </h3>
               <p class="text-base font-custom-main font-semibold text-rose-400">
                 join the kimmunity!
               </p>
             </div>
            </div>
 
            <!-- Discord logo -->
            <div class="
              absolute -top-4 -right-4 flex items-center p-3 
              bg-rose-400 rounded-full
            ">
              <DiscordLogo width="24" height="24" />
            </div>
          </div>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .font-custom-main {
    font-family: "Zen Maru Gothic", sans-serif;
    font-style: normal;
  }

  .font-custom-second {
    font-family: "M PLUS Rounded 1c", sans-serif;
    font-style: normal;
  }

  .title-outline {
    /* Value looks weird but this is to prevent glyph holes showing for dots  */
    -webkit-text-stroke-width: 29.3px;
    -webkit-text-stroke-color: var(--color-pink-100);
  }

  .subtitle-outline {
    -webkit-text-stroke-width: 16px;
    -webkit-text-stroke-color: var(--color-pink-100);
  }
</style>
