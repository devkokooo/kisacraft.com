---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import imgJuice from "../assets/juice.png";
import imgCake from "../assets/cake.png";
---

<Layout>
  <main class="w-screen h-screen grid place-items-center">
    <div>
      <!-- Title wrapper -->
      <div class="flex gap-6 justify-center items-center">
        <!-- Title, pink gradient text with white accent border -->
        <div class="relative grid place-items-center">
          <!-- Background "accent" border -->
          <h1 class="title-outline font-custom font-extrabold text-8xl tracking-tight">
            Kisacraft
          </h1>

          <!-- Main title gradient text -->
          <h1 class="
            fixed text-transparent bg-clip-text
            bg-linear-to-t from-red-800 via-rose-600 to-rose-400
            z-10 font-custom font-extrabold text-8xl tracking-tight
          ">
            Kisacraft
          </h1>
        </div>
      </div>

      <!-- Subtitle, cute japanese katakana text -->
      <div class="mt-6 flex gap-6 justify-center items-center">
        <!-- Cute image wrapper -->
        <div class="-m-0.5 p-2.5 rounded-full bg-pink-100">
          <Image src={imgJuice} alt="juice" width="32" height="32" class="-rotate-20" />
        </div>

        <!-- Heart -->
        <span class="text-pink-100 text-3xl">♥</span>

        <!-- Subtitle wrapper -->
        <div class="relative grid place-items-center">
          <!-- Background "accent" border -->
          <h2 class="subtitle-outline font-custom font-extrabold text-3xl tracking-tighter">
            キサクラフト
          </h2>

          <!-- Subtitle gradient text -->
          <h2 class="
            fixed text-transparent bg-clip-text
            bg-linear-to-t from-red-800 via-rose-600 to-rose-400
            z-10 font-custom font-extrabold text-3xl tracking-tighter
          ">
            キサクラフト
          </h2>
        </div>

        <!-- Heart -->
        <span class="text-pink-100 text-3xl">♥</span>

        <!-- Cute image wrapper -->
        <div class="-m-0.5 p-2.5 rounded-full bg-pink-100">
          <Image src={imgCake} alt="juice" width="32" height="32" class="rotate-10" />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .font-custom {
    font-family: "M Plus Rounded 1c", sans-serif;
    font-style: normal;
  }

  .title-outline {
    -webkit-text-stroke-width: 32px;
    -webkit-text-stroke-color: var(--color-pink-100);
  }

  .subtitle-outline {
    -webkit-text-stroke-width: 16px;
    -webkit-text-stroke-color: var(--color-pink-100);
  }
</style>
